---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import Link from "@components/Link.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

// const projects = (await getCollection("projects"))
//   .filter(project => !project.data.draft)
//   .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
//   .slice(0,SITE.NUM_PROJECTS_ON_HOMEPAGE);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Hi, I'm Yogesh <span class="text-xl">👋🏻</span>
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            I'm a Pragmatic engineer who thrives in solving complex problems and owns systems end to end: planning, implementation, debugging, and operating in production. I have no qualms about getting my hands dirty with any programming language—proficient use of AI tools like Cursor, Claude Code has reduced the barrier further. In my experience with systems that are opaque, slow, or unreliable, small pragmatic changes can go a long way.
          </p>
          <p class="animate">
            I’m very comfortable with web servers, async background workers, building complex long-running workflows, talking to databases and queues, and building out scalable and reliable systems. I also have a strong focus on AI systems, working extensively with Semantic Search, Vector Databases, and LangGraph.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Recent posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            If you want to get in touch with me about something or just to say hi,
            reach out on social media or send me an email.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link 
              href="javascript:void(0);" 
              id="email-link" 
              aria-label={`Email ${SITE.NAME}`}
              dataEmail={SITE.EMAIL.split('').reverse().join('')}
            >
              Mail
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>

<script>
  const emailLink = document.getElementById('email-link');
  if (emailLink) {
    emailLink.addEventListener('click', () => {
      const reversedEmail = emailLink.getAttribute('data-email');
      if (reversedEmail) {
        const email = reversedEmail.split('').reverse().join('');
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>
